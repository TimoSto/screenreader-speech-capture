{
  "name": "screenreader-speech-capture-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** run build",
    "dev": "pnpm --filter screenreader-speech-capture run dev",
    "dev:ui": "pnpm --filter @screenreader-speech-capture/ui run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "openapi": "tsx packages/shared/src/openapi/write.ts && prettier --write docs/usage/openapi.yaml",
    "fake-speech": "tsx tools/fake-speech/src/fake-speech.ts",
    "release:check-title": "tsx tools/release/src/bin/check-pr-title.ts",
    "release:determine-version": "tsx tools/release/src/bin/determine-version.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.9",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte-eslint-parser": "1.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
