{
  "name": "screenreader-speech-capture",
  "version": "0.0.0-dev",
  "description": "Capture what a screen reader says (JAWS / NVDA via a SAPI 5 socket voice) and expose it over HTTP for automated tests.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "screenreader-speech-capture": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/bin/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@screenreader-speech-capture/shared": "workspace:*",
    "tsdown": "0.23.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimoSto/screenreader-speech-capture.git",
    "directory": "packages/bridge"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.85"
  }
}
