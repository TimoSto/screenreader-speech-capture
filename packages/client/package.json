{
  "name": "screenreader-speech-capture-client",
  "version": "0.0.0-dev",
  "description": "Test client for the screenreader-speech-capture bridge: library, Playwright fixture and CLI.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./playwright": {
      "types": "./dist/playwright.d.mts",
      "default": "./dist/playwright.mjs"
    }
  },
  "bin": {
    "screenreader-speech-capture-client": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@playwright/test": "1.65.0",
    "@screenreader-speech-capture/shared": "workspace:*",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "valibot": "1.5.0"
  },
  "homepage": "https://github.com/TimoSto/screenreader-speech-capture/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/TimoSto/screenreader-speech-capture/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimoSto/screenreader-speech-capture.git",
    "directory": "packages/client"
  },
  "peerDependencies": {
    "@playwright/test": "1.65.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
